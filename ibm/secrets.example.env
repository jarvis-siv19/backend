# Code Engine secret contents for the SplitLLM backend.
#
# Copy to `secrets.env` (gitignored), fill in the real values, then run
# ./deploy.sh — it loads this file into a Code Engine secret and binds every
# key into the app as an environment variable.
#
# Blank lines and lines starting with `#` are ignored by `--from-env-file`.
# Do NOT quote values: Code Engine takes the raw text after `=`, so
# FOO="bar" becomes the literal `"bar"` including the quotes.

# ─── MongoDB (Atlas M0, Mumbai / ap-south-1) ────────────────────────────
# Code Engine has no stable egress IP, so the Atlas Network Access list has
# to be 0.0.0.0/0. Use a dedicated DB user scoped to this database only.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/?retryWrites=true&w=majority
DB_NAME=splitllm

# ─── Supabase (asymmetric JWT validation via JWKS) ──────────────────────
SUPABASE_URL=https://jolggtuiatbxrjomfbxl.supabase.co
SUPABASE_ANON_KEY=sb_publishable_Y-dpGB63ipwupP3Y3-6HAw_6d6w3wpO
# Optional. Empty = account deletion skips removing the Supabase auth record.
# SUPABASE_SERVICE_ROLE_KEY=   <- uncomment and fill in when you have a value

# ─── CORS / links ───────────────────────────────────────────────────────
# These are the origins the Flutter *web* build is served from — not the
# backend's own URL. Only add the Code Engine app URL here if you later serve
# the web build from Code Engine too. Native iOS/Android builds are unaffected
# by CORS entirely.
CORS_ORIGINS=https://splitllm.com,https://www.splitllm.com
APP_BASE_URL=https://splitllm.com

# ─── Currency / FX ──────────────────────────────────────────────────────
DEFAULT_CURRENCY=INR
# FX_API_URL=   <- uncomment and fill in when you have a value

# ─── LLM (Catalyst QuickML) ─────────────────────────────────────────────
# Unlike AppSail, Code Engine does not reserve the ZOHO_/CATALYST_ prefixes,
# but the app still reads the QUICKML_/OAUTH_ names — leave them as-is.
LLM_ENABLED=false
# QUICKML_LLM_ENDPOINT=   <- uncomment and fill in when you have a value
QUICKML_LLM_MODEL=glm-4.7-flash
# QUICKML_VLM_ENDPOINT=   <- uncomment and fill in when you have a value
QUICKML_VLM_MODEL=qwen3.6-35b-vl
QUICKML_ORG_ID=60078340202
OAUTH_ACCOUNTS_URL=https://accounts.zoho.in
# OAUTH_CLIENT_ID=   <- uncomment and fill in when you have a value
# OAUTH_CLIENT_SECRET=   <- uncomment and fill in when you have a value
# OAUTH_REFRESH_TOKEN=   <- uncomment and fill in when you have a value

# ─── ZeptoMail ──────────────────────────────────────────────────────────
ZEPTOMAIL_ENABLED=false
ZEPTOMAIL_API_URL=https://api.zeptomail.in
# ZEPTOMAIL_TOKEN=   <- uncomment and fill in when you have a value
ZEPTOMAIL_FROM_ADDRESS=noreply@splitllm.com
ZEPTOMAIL_FROM_NAME=SplitLLM
