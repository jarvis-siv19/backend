# Files NOT uploaded to Cloud Build by `gcloud run deploy --source .`
# (Dockerfile, requirements.txt and app/ are intentionally kept.)
.git/
.gitignore
venv/
.venv/
env/
__pycache__/
*.py[cod]

# Secrets / local config — supplied via Cloud Run env vars & Secret Manager.
.env
.env.*
!.env.example

# Dev-only.
tests/
test_api.py
requirements-dev.txt
docker-compose.yml
.dockerignore
*.md
.pytest_cache/
.DS_Store
